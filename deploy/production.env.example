# Copy to .env.production. Never use compose.yaml as a production overlay.
COMPOSE_PROJECT_NAME=voxriva-production
COMPOSE_FILE=compose.production.yaml
VOXRIVA_IMAGE=ghcr.io/alexivanchyk/voxriva:0.1.1
VOXRIVA_HOST=notifications.example.org
VOXRIVA_SECRETS_DIR=./secrets
# Optional: bind only a specific interface, e.g. 127.0.0.1 for a local TLS smoke.
VOXRIVA_HTTPS_BIND=0.0.0.0
# Explicit private SMTP destinations only; leave empty for public providers.
VOXRIVA_SMTP_ALLOWED_HOSTS=[]

# optional = user opt-in; required = enrollment before dashboard access
VOXRIVA_MFA_POLICY=optional

# Optional MCP overlay: add compose.mcp.production.yaml to COMPOSE_FILE.
# Use the same release version for API, workers and MCP.
VOXRIVA_MCP_IMAGE=ghcr.io/alexivanchyk/voxriva-mcp:0.1.1
